# Set this after running `python cli.py models` and choosing an available model.
OPENAI_API_KEY=
BLOOM_MODEL=
BLOOM_PROVIDER=openai
BLOOM_REASONING_EFFORT=low
BLOOM_API_RETRIES=5

# All state stays on this Mac. The path is resolved relative to this repository.
BLOOM_DB_PATH=data/bloom.sqlite3

# BlueBubbles is optional until the server is installed and configured.
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_TOKEN=
BLOOM_EVENT_TOKEN=

# How bloom behaves in a conversation.
BLOOM_POLL_INTERVAL=3
BLOOM_MAX_MESSAGE_AGE=300
BLOOM_ACK_AFTER=4
BLOOM_ACK_TEXT=
BLOOM_FAILURE_TEXT=

# Connected apps through Composio.
COMPOSIO_API_KEY=

# Speech, optional.
SARVAM_API_KEY=

# Optional Composio scoping
COMPOSIO_TOOLKITS=
COMPOSIO_TOOLS=
COMPOSIO_USER_ID=
COMPOSIO_AUTH_CONFIGS=
COMPOSIO_TOOLKIT_LIMIT=
COMPOSIO_RESULT_LIMIT=
BLOOM_BROWSER_TASKS=
COMPOSIO_ROUTER=
BLOOM_LOCATION_URL=
BLOOM_LOCATION_TTL=900
SARVAM_SPEAKER=
SARVAM_MODE=

# Recall, optional. Without a key bloom simply does not remember across restarts.
PINECONE_API_KEY=
PINECONE_INDEX=bloom-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
BLOOM_EMBED_MODEL=text-embedding-3-small
